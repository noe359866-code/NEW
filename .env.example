# Nexo Play - Stremio Addon Configuration

# ============================================================================
# CONFIGURACIÓN DEL SERVIDOR
# ============================================================================

# Puerto del servidor proxy
PORT=3000

# URL base del proxy (para cuando el addon se ejecuta detrás de un reverse proxy)
PROXY_BASE_URL=http://localhost:3000

# Alternativas (mismas variables con prefijo)
NEXOPLAY_PORT=3000
NEXOPLAY_BASE_URL=http://localhost:3000

# ============================================================================
# CONFIGURACIÓN DE VIMEUS
# ============================================================================

# View Key de Vimeus (requerida para todos los embeds)
# Obtén tu view_key en: https://vimeus.com/settings/general
VIMEUS_VIEW_KEY=KgY3ACTXKP1F-sv8M6TEKIxqWToi6pyhFkLI1qDkUmA

# URL base de Vimeus
VIMEUS_BASE_URL=https://vimeus.com

# ============================================================================
# CONFIGURACIÓN DE APIs EXTERNAS (Opcional)
# ============================================================================

# OMDb API (para obtener nombres de películas/series)
# OMDB_API_KEY=tu_api_key_aqui
# OMDB_API_URL=http://www.omdbapi.com/

# TMDb API (para obtener nombres de películas/series)
# TMDB_API_KEY=tu_api_key_aqui
# TMDB_API_URL=https://api.themoviedb.org/3

# ============================================================================
# CONFIGURACIÓN DE LOGGING
# ============================================================================

# Nivel de logging (debug, info, warn, error)
# LOG_LEVEL=info
